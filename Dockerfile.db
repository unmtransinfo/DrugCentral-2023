# Use official Postgres image as base
FROM postgres:14.17

# Runtime Postgres environment variables are provided by compose.yml.

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        libboost-all-dev \
        libeigen3-dev \
        libpq-dev \
        postgresql-server-dev-14 \
        libfreetype6-dev \
        python3-dev \
        python3-numpy \
        git \
        wget \
        tar \
        ca-certificates \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        zlib1g-dev \
        libxml2-dev \
        libexpat1-dev \
        libffi-dev \
        libsqlite3-dev && \
    rm -rf /var/lib/apt/lists/*

# Clone and build RDKit
RUN cd /tmp && \
    git clone https://github.com/rdkit/rdkit.git && \
    wget https://archives.boost.io/release/1.81.0/source/boost_1_81_0.tar.gz && \
    tar xzf boost_1_81_0.tar.gz && \
    cd boost_1_81_0 && \
    ./bootstrap.sh && \
    ./b2 install

# Build RDKit with PostgreSQL and custom options.
# Resolve PostgreSQL paths with pg_config instead of hardcoding an architecture-specific libpq path.
RUN cd /tmp/rdkit && mkdir build && cd build && \
    PG_ROOT="$(pg_config --bindir | sed 's#/bin$##')" && \
    PG_INCLUDE_DIR="$(pg_config --includedir-server)" && \
    PG_LIBRARY="$(pg_config --libdir)/libpq.so" && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release \
      -DBOOST_ROOT=/usr/local \
      -DBOOST_INCLUDEDIR=/usr/local/include \
      -DBOOST_LIBRARYDIR=/usr/local/lib \
      -DBoost_NO_SYSTEM_PATHS=ON \
      -DBoost_NO_BOOST_CMAKE=ON \
      -DPython3_EXECUTABLE=$(which python3) \
      -DRDK_BUILD_PYTHON_WRAPPERS=OFF \
      -DRDK_BUILD_RDRAWPYTHON=OFF \
      -DRDK_BUILD_INCHI_SUPPORT=ON \
      -DRDK_BUILD_AVALON_SUPPORT=ON \
      -DRDK_BUILD_PGSQL=ON \
      -DPostgreSQL_ROOT="${PG_ROOT}" \
      -DPostgreSQL_INCLUDE_DIR="${PG_INCLUDE_DIR}" \
      -DPostgreSQL_LIBRARY="${PG_LIBRARY}" && \
    make -j2 && make install

# Copy initialization script and database dump
COPY init/wait-for-db.sh /docker-entrypoint-initdb.d/wait-for-db.sh
COPY init/drugcen.dump /docker-entrypoint-initdb.d/drugcen.dump
RUN chmod +x /docker-entrypoint-initdb.d/wait-for-db.sh && \
    chmod 644 /docker-entrypoint-initdb.d/drugcen.dump
